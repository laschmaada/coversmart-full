@tailwind base;
@tailwind components;
@tailwind utilities;

/* ─── TOKENS ──────────────────────────────────────────────────────────────────── */
:root {
  --bg:        #09051a;
  --bg2:       #110c28;
  --bg3:       #1a1240;
  --surface:   rgba(255,255,255,0.04);
  --border:    rgba(255,255,255,0.09);
  --border2:   rgba(255,255,255,0.15);
  --text:      #f0ecff;
  --text2:     rgba(240,236,255,0.6);
  --text3:     rgba(240,236,255,0.35);
  --red:       #ef4444;
  --red-g:     rgba(239,68,68,0.35);
  --orange:    #f97316;
  --purple:    #8b5cf6;
  --green:     #22c55e;
  --blue:      #3b82f6;
  /* Fonts loaded via next/font in layout.tsx — variables set on <body> */
  --font-d:    "Audiowide", cursive;
  --font-b:    "Rajdhani", sans-serif;
  --r-sm:      6px;
  --r-md:      10px;
  --r-lg:      14px;
  --r-xl:      20px;

  /* shadcn compat */
  --background:          9 5 26;
  --foreground:          240 236 255;
  --card:                17 12 40;
  --card-foreground:     240 236 255;
  --popover:             17 12 40;
  --popover-foreground:  240 236 255;
  --primary:             240 236 255;
  --primary-foreground:  9 5 26;
  --secondary:           26 18 64;
  --secondary-foreground:240 236 255;
  --muted:               26 18 64;
  --muted-foreground:    154 147 180;
  --accent:              26 18 64;
  --accent-foreground:   240 236 255;
  --destructive:         239 68 68;
  --destructive-foreground:255 255 255;
  --border:              rgba(255,255,255,0.09);
  --input:               rgba(255,255,255,0.09);
  --ring:                239 68 68;
  --radius:              0.625rem;
}

@layer base {
  * { box-sizing: border-box; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body, "Rajdhani"), sans-serif;
    -webkit-font-smoothing: antialiased;
  }
}

/* ─── ANIMATIONS ──────────────────────────────────────────────────────────────── */

/* ─── MARKETING PAGE TOKEN ALIASES ─────────────────────────────────────────── */
:root {
  --cs-purple-deep:    #1a1035;
  --cs-purple-mid:     #2d1f5e;
  --cs-purple-light:   #4a2d8a;
  --cs-purple-soft:    #6b4baa;
  --cs-red:            #ef4444;
  --cs-red-glow:       rgba(239, 68, 68, 0.8);
  --cs-red-glow-soft:  rgba(239, 68, 68, 0.4);
  --cs-red-glow-faint: rgba(239, 68, 68, 0.15);
  --cs-white:          #ffffff;
  --cs-white-80:       rgba(255,255,255,0.8);
  --cs-white-60:       rgba(255,255,255,0.6);
  --cs-white-30:       rgba(255,255,255,0.3);
  --cs-white-10:       rgba(255,255,255,0.1);
  --cs-white-05:       rgba(255,255,255,0.05);
  --cs-border:         rgba(255,255,255,0.12);
  --cs-border-accent:  rgba(239, 68, 68, 0.4);
  --cs-radius-sm:      6px;
  --cs-radius-md:      10px;
  --cs-radius-lg:      16px;
  --cs-shadow-red:     0 0 20px rgba(239,68,68,0.5), 0 0 60px rgba(239,68,68,0.2);
  --cs-bg:             #09051a;
  --cs-text:           #f0ecff;
}

@keyframes fadeup     { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }
@keyframes fadein     { from{opacity:0} to{opacity:1} }
@keyframes orbfloat   { 0%,100%{transform:translate(0,0) scale(1)} 33%{transform:translate(28px,-36px) scale(1.04)} 66%{transform:translate(-16px,18px) scale(0.97)} }
@keyframes ticker     { from{transform:translateX(0)} to{transform:translateX(-50%)} }
@keyframes pulsedot   { 0%,100%{opacity:1;box-shadow:0 0 6px var(--red)} 50%{opacity:0.4;box-shadow:0 0 16px var(--red)} }
@keyframes pulseglow  { 0%,100%{box-shadow:0 0 8px var(--red-g)} 50%{box-shadow:0 0 24px rgba(239,68,68,0.8),0 0 48px rgba(239,68,68,0.3)} }
@keyframes shimmer    { from{background-position:200% center} to{background-position:-200% center} }
@keyframes spin       { to{transform:rotate(360deg)} }

/* ─── SHARED UTILITIES ────────────────────────────────────────────────────────── */
.font-display { font-family: var(--font-display, 'Audiowide'), cursive; }
.animate-fadeup { animation: fadeup 0.6s ease both; }
.animate-fadein { animation: fadein 0.4s ease both; }
.cs-root { background: var(--bg); min-height: 100vh; color: var(--text); font-family: var(--font-body, "Rajdhani"), sans-serif; overflow-x: hidden; }

/* Fixed background layers shared across all pages */
.cs-bg   { position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(ellipse 90% 90% at 65% 40%,#2d1f6e 0%,#09051a 65%); }
.cs-grid { position:fixed;inset:0;z-index:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,0.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.025) 1px,transparent 1px);background-size:56px 56px; }
.cs-orb1 { position:fixed;width:520px;height:520px;border-radius:50%;background:rgba(74,45,138,0.28);filter:blur(90px);right:5%;top:5%;z-index:0;pointer-events:none;animation:orbfloat 14s ease-in-out infinite; }
.cs-orb2 { position:fixed;width:280px;height:280px;border-radius:50%;background:rgba(239,68,68,0.09);filter:blur(70px);right:28%;bottom:15%;z-index:0;pointer-events:none;animation:orbfloat 10s ease-in-out infinite reverse; }

/* ─── BUTTONS ─────────────────────────────────────────────────────────────────── */
.btn { display:inline-flex;align-items:center;gap:.45rem;font-family:var(--font-display, 'Audiowide'), cursive;font-size:0.6rem;letter-spacing:.12em;text-transform:uppercase;padding:.75rem 1.75rem;border-radius:var(--r-sm);cursor:pointer;border:none;transition:all .25s;text-decoration:none;white-space:nowrap;justify-content:center; }
.btn-lg { padding:.95rem 2.25rem;font-size:.65rem; }
.btn-sm { padding:.5rem 1.1rem;font-size:.55rem; }
.btn-primary { background:var(--red);color:#fff; }
.btn-primary:hover { background:#ff5555;box-shadow:0 0 24px rgba(239,68,68,0.6),0 0 60px rgba(239,68,68,0.2);transform:translateY(-2px); }
.btn-primary:disabled { opacity:.5;cursor:not-allowed;transform:none;box-shadow:none; }
.btn-outline { background:transparent;color:var(--text);border:1.5px solid var(--border2); }
.btn-outline:hover { border-color:var(--red);color:var(--red);box-shadow:0 0 18px rgba(239,68,68,0.35);transform:translateY(-2px); }
.btn-ghost { background:transparent;color:var(--text2);border:1px solid var(--border); }
.btn-ghost:hover { color:var(--red);border-color:var(--red); }
.btn-google { background:rgba(255,255,255,0.06);color:var(--text);border:1px solid var(--border2);gap:.6rem; }
.btn-google:hover { background:rgba(255,255,255,0.1);border-color:var(--border2); }
.btn-full { width:100%; }

/* Loading spinner for buttons */
.btn-spinner { width:14px;height:14px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite; }

/* ─── FORM ELEMENTS ───────────────────────────────────────────────────────────── */
.cs-input { width:100%;background:rgba(255,255,255,0.05);border:1px solid var(--border2);border-radius:var(--r-sm);color:var(--text);padding:.75rem 1rem;font-family:var(--font-body, 'Rajdhani'), sans-serif;font-size:.95rem;font-weight:500;outline:none;transition:all .2s; }
.cs-input:focus { border-color:rgba(239,68,68,0.5);box-shadow:0 0 0 3px rgba(239,68,68,0.1); }
.cs-input::placeholder { color:var(--text3); }
.cs-input.error { border-color:rgba(239,68,68,0.6); }
.cs-label { display:block;font-family:var(--font-display, 'Audiowide'), cursive;font-size:.55rem;letter-spacing:.16em;color:var(--text2);text-transform:uppercase;margin-bottom:.5rem; }
.cs-field { display:flex;flex-direction:column;gap:.35rem; }
.cs-field-error { font-size:.78rem;color:var(--red);font-weight:500;margin-top:.2rem; }
.cs-select { width:100%;background:rgba(255,255,255,0.05);border:1px solid var(--border2);border-radius:var(--r-sm);color:var(--text);padding:.75rem 1rem;font-family:var(--font-body, 'Rajdhani'), sans-serif;font-size:.95rem;font-weight:500;outline:none;transition:all .2s;cursor:pointer; }
.cs-select:focus { border-color:rgba(239,68,68,0.5); }
.cs-select option { background:#1a1240; }
.cs-textarea { width:100%;background:rgba(255,255,255,0.05);border:1px solid var(--border2);border-radius:var(--r-sm);color:var(--text);padding:.75rem 1rem;font-family:var(--font-body, 'Rajdhani'), sans-serif;font-size:.95rem;font-weight:500;outline:none;transition:all .2s;resize:vertical;min-height:100px; }
.cs-textarea:focus { border-color:rgba(239,68,68,0.5); }

/* ─── CARDS ───────────────────────────────────────────────────────────────────── */
.cs-card { background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:var(--r-lg);overflow:hidden; }
.cs-card-head { display:flex;align-items:center;gap:.6rem;padding:1rem 1.25rem;border-bottom:1px solid var(--border); }
.cs-card-title { font-family:var(--font-display, 'Audiowide'), cursive;font-size:.65rem;letter-spacing:.1em;color:var(--text);text-transform:uppercase;flex:1; }
.cs-card-body { padding:1.25rem; }

/* ─── BADGES ──────────────────────────────────────────────────────────────────── */
.badge { display:inline-flex;align-items:center;gap:.25rem;font-family:var(--font-display, 'Audiowide'), cursive;font-size:.5rem;letter-spacing:.12em;padding:.22rem .6rem;border-radius:4px;text-transform:uppercase;white-space:nowrap; }
.badge-red    { background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.3);color:var(--red); }
.badge-orange { background:rgba(249,115,22,0.12);border:1px solid rgba(249,115,22,0.3);color:var(--orange); }
.badge-green  { background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.25);color:var(--green); }
.badge-purple { background:rgba(139,92,246,0.12);border:1px solid rgba(139,92,246,0.3);color:var(--purple); }
.badge-gray   { background:rgba(255,255,255,0.06);border:1px solid var(--border);color:var(--text2); }

/* ─── MARKETING NAV ───────────────────────────────────────────────────────────── */
.cs-nav { position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(9,5,26,0.88);backdrop-filter:blur(20px);border-bottom:1px solid var(--border); }
.cs-nav-inner { max-width:1200px;margin:0 auto;padding:0 2rem;height:68px;display:flex;align-items:center;gap:3rem; }
.cs-logo { font-family:var(--font-display, 'Audiowide'), cursive;font-size:1.05rem;letter-spacing:.06em;color:var(--text);text-decoration:none;flex-shrink:0; }
.cs-logo span { color:var(--red); }
.cs-nav-links { display:flex;gap:2rem;list-style:none;flex:1; }
.cs-nav-link { font-family:var(--font-display, 'Audiowide'), cursive;font-size:.58rem;letter-spacing:.16em;color:var(--text2);text-decoration:none;transition:color .2s;text-transform:uppercase; }
.cs-nav-link:hover { color:var(--red); }
.cs-nav-actions { display:flex;gap:.75rem;align-items:center;margin-left:auto; }

/* ─── DASHBOARD LAYOUT ────────────────────────────────────────────────────────── */
.dash-root { display:flex;height:100vh;overflow:hidden;background:var(--bg); }
.sidebar { width:228px;flex-shrink:0;height:100vh;overflow-y:auto;background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;padding:1.25rem 0; }
.sidebar::-webkit-scrollbar { width:3px; }
.sidebar::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.08);border-radius:2px; }
.sb-logo { font-family:var(--font-display, 'Audiowide'), cursive;font-size:.9rem;letter-spacing:.06em;color:var(--text);padding:.25rem 1.25rem 1.5rem;display:block;text-decoration:none; }
.sb-logo span { color:var(--red); }
.sb-section { font-family:var(--font-display, 'Audiowide'), cursive;font-size:.46rem;letter-spacing:.22em;color:var(--text3);text-transform:uppercase;padding:.75rem 1.25rem .4rem; }
.sb-item { display:flex;align-items:center;gap:.7rem;padding:.625rem 1.25rem;color:var(--text2);font-size:.9rem;font-weight:600;cursor:pointer;transition:all .18s;border-left:2px solid transparent;text-decoration:none; }
.sb-item:hover { color:var(--text);background:rgba(255,255,255,0.04); }
.sb-item.active { color:var(--red);background:rgba(239,68,68,0.08);border-left-color:var(--red); }
.sb-badge { margin-left:auto;background:var(--red);color:#fff;font-family:var(--font-display, 'Audiowide'), cursive;font-size:.46rem;padding:.15rem .45rem;border-radius:20px; }
.sb-divider { height:1px;background:var(--border);margin:.75rem 0; }
.sb-user { margin-top:auto;padding:1rem 1.25rem;border-top:1px solid var(--border); }
.sb-user-inner { display:flex;align-items:center;gap:.65rem; }
.sb-avatar { width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#4a2d8a,#ef4444);display:flex;align-items:center;justify-content:center;font-family:var(--font-display, 'Audiowide'), cursive;font-size:.55rem;color:#fff;flex-shrink:0; }
.sb-user-name { font-weight:700;font-size:.9rem;color:var(--text);line-height:1.2; }
.sb-user-plan { font-family:var(--font-display, 'Audiowide'), cursive;font-size:.46rem;letter-spacing:.1em;color:var(--red); }
.sb-scroll { flex:1;overflow-y:auto; }
.sb-scroll::-webkit-scrollbar { width:0; }

.dash-main { flex:1;overflow-y:auto;display:flex;flex-direction:column; }
.dash-main::-webkit-scrollbar { width:5px; }
.dash-main::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.09);border-radius:3px; }

.topbar { display:flex;align-items:center;gap:1rem;padding:.9rem 1.75rem;border-bottom:1px solid var(--border);background:rgba(9,5,26,0.85);backdrop-filter:blur(12px);position:sticky;top:0;z-index:10;flex-shrink:0; }
.topbar-title { font-family:var(--font-display, 'Audiowide'), cursive;font-size:.8rem;letter-spacing:.04em;color:var(--text); }
.topbar-sub { font-size:.82rem;color:var(--text2);font-weight:500;margin-top:.1rem; }
.topbar-right { display:flex;align-items:center;gap:.75rem;margin-left:auto; }
.topbar-btn { display:flex;align-items:center;gap:.4rem;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-sm);color:var(--text2);font-family:var(--font-display, 'Audiowide'), cursive;font-size:.55rem;letter-spacing:.1em;padding:.45rem .9rem;cursor:pointer;text-transform:uppercase;transition:all .2s; }
.topbar-btn:hover { border-color:var(--red);color:var(--red); }
.notif-btn { position:relative;width:34px;height:34px;display:flex;align-items:center;justify-content:center;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-sm);cursor:pointer;color:var(--text2);transition:all .2s; }
.notif-dot { position:absolute;top:6px;right:7px;width:7px;height:7px;border-radius:50%;background:var(--red);border:1.5px solid var(--bg);animation:pulsedot 2s ease-in-out infinite; }
.dash-content { padding:1.5rem 1.75rem;display:flex;flex-direction:column;gap:1.5rem;animation:fadeup .5s ease both; }

/* ─── AUTH PAGES ──────────────────────────────────────────────────────────────── */
.auth-page { min-height:100vh;display:flex;align-items:center;justify-content:center;padding:2rem;position:relative;z-index:1; }
.auth-card { width:100%;max-width:440px;background:rgba(17,12,40,0.85);border:1px solid var(--border2);border-radius:var(--r-xl);padding:2.5rem;backdrop-filter:blur(30px);box-shadow:0 20px 60px rgba(0,0,0,0.5),0 0 80px rgba(74,45,138,0.15); }
.auth-logo { font-family:var(--font-display, 'Audiowide'), cursive;font-size:1.1rem;letter-spacing:.06em;color:var(--text);display:block;text-align:center;margin-bottom:1.75rem;text-decoration:none; }
.auth-logo span { color:var(--red); }
.auth-title { font-family:var(--font-display, 'Audiowide'), cursive;font-size:1.2rem;letter-spacing:.04em;color:var(--text);text-align:center;margin-bottom:.4rem;text-transform:uppercase; }
.auth-sub { font-size:.9rem;color:var(--text2);text-align:center;margin-bottom:2rem;font-weight:500;line-height:1.5; }
.auth-form { display:flex;flex-direction:column;gap:1.1rem; }
.auth-divider { display:flex;align-items:center;gap:.75rem;margin:.5rem 0; }
.auth-divider-line { flex:1;height:1px;background:var(--border); }
.auth-divider-text { font-family:var(--font-display, 'Audiowide'), cursive;font-size:.5rem;letter-spacing:.18em;color:var(--text3);text-transform:uppercase; }
.auth-footer { text-align:center;font-size:.85rem;color:var(--text2);margin-top:1.25rem;font-weight:500; }
.auth-link { color:var(--red);text-decoration:none;transition:opacity .2s; }
.auth-link:hover { opacity:.8;text-decoration:underline; }
.auth-error { background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:var(--r-sm);padding:.75rem 1rem;font-size:.85rem;color:#fca5a5;font-weight:500;display:flex;align-items:flex-start;gap:.5rem; }

/* ─── DISCLAIMER ──────────────────────────────────────────────────────────────── */
.cs-disclaimer { display:flex;gap:.7rem;background:rgba(239,68,68,0.04);border:1px solid rgba(239,68,68,0.12);border-radius:var(--r-md);padding:.9rem 1.1rem;align-items:flex-start; }
.cs-disclaimer svg { color:var(--red);flex-shrink:0;margin-top:2px; }
.cs-disclaimer p { font-size:.74rem;color:var(--text3);line-height:1.6;font-weight:500; }
.cs-disclaimer strong { color:var(--text2); }

/* ─── LEGAL TICKER ────────────────────────────────────────────────────────────── */
.ticker { background:rgba(9,5,26,0.9);border-top:1px solid var(--border);border-bottom:1px solid var(--border);overflow:hidden;padding:.8rem 0; }
.ticker-track { display:inline-flex;gap:3rem;white-space:nowrap;animation:ticker 28s linear infinite; }
.ticker-item { display:inline-flex;align-items:center;gap:.4rem;font-family:var(--font-display, 'Audiowide'), cursive;font-size:.5rem;letter-spacing:.2em;color:var(--text3);text-transform:uppercase; }

/* ─── RESPONSIVE ──────────────────────────────────────────────────────────────── */
@media (max-width: 768px) {
  .sidebar { display:none; }
  .cs-nav-links { display:none; }
  .dash-content { padding:1rem; }
}
.cs-section-eyebrow {
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  color: var(--red);
  text-transform: uppercase;
  margin-bottom: 1rem;
}
.cs-section-title {
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: clamp(1.6rem, 3.5vw, 2.8rem);
  font-weight: 400;
  line-height: 1.15;
  letter-spacing: 0.03em;
  color: var(--cs-white);
  margin-bottom: 1.25rem;
  text-transform: uppercase;
  text-align: center;
}
.cs-text-left { text-align: left; }
.cs-section-sub {
  font-size: 1.1rem;
  line-height: 1.7;
  color: var(--cs-white-60);
  max-width: 560px;
  margin: 0 auto 3rem;
  text-align: center;
  font-weight: 500;
}
.cs-section-sub.cs-text-left { text-align: left; margin: 0 0 2rem; }

/* ─── LAYOUT ────────────────────────────────────────────────────────────────── */
.cs-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}
.cs-section {
  padding: 6rem 0;
  position: relative;
}

/* ─── BUTTONS ────────────────────────────────────────────────────────────────── */
.cs-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  font-weight: 400;
  padding: 0.75rem 1.75rem;
  border-radius: var(--cs-radius-sm);
  cursor: pointer;
  text-decoration: none;
  transition: all 0.25s ease;
  text-transform: uppercase;
  border: none;
  white-space: nowrap;
}
.cs-btn-lg { padding: 1rem 2.25rem; font-size: 0.72rem; }
.cs-btn-primary {
  background: var(--red);
  color: var(--cs-white);
}
.cs-btn-primary:hover {
  background: #ff5555;
  box-shadow: var(--cs-shadow-red);
  transform: translateY(-2px);
}
.cs-btn-outline {
  background: transparent;
  color: var(--cs-white);
  border: 1.5px solid var(--cs-white-30);
}
.cs-btn-outline:hover {
  border-color: var(--red);
  color: var(--red);
  box-shadow: 0 0 20px var(--cs-red-glow-soft);
  transform: translateY(-2px);
}
.cs-btn-ghost {
  background: transparent;
  color: var(--cs-white-80);
  border: 1px solid var(--cs-white-10);
}
.cs-btn-ghost:hover {
  color: var(--red);
  border-color: var(--red);
}
.cs-full { width: 100%; justify-content: center; }

/* ─── NAV ─────────────────────────────────────────────────────────────────────── */
.cs-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(26,16,53,0.85);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--cs-border);
}
.cs-nav-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  height: 68px;
  display: flex;
  align-items: center;
  gap: 3rem;
}
.cs-logo {
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 1.1rem;
  letter-spacing: 0.08em;
  color: var(--cs-white);
  text-decoration: none;
  flex-shrink: 0;
}
.cs-logo-accent { color: var(--red); }
.cs-logo-lg { font-size: 1.5rem; }
.cs-nav-links {
  display: flex;
  gap: 2rem;
  list-style: none;
  margin: 0;
  padding: 0;
  flex: 1;
}
.cs-nav-link {
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 0.62rem;
  letter-spacing: 0.15em;
  color: var(--cs-white-60);
  text-decoration: none;
  transition: all 0.2s;
  text-transform: uppercase;
}
.cs-nav-link:hover {
  color: var(--red);
  text-shadow: 0 0 8px var(--cs-red-glow);
}
.cs-nav-actions { display: flex; gap: 0.75rem; align-items: center; }
.cs-hamburger {
  display: none;
  background: none;
  border: none;
  color: white;
  cursor: pointer;
  margin-left: auto;
}
.cs-hamburger-lines {
  display: block;
  width: 24px;
  height: 2px;
  background: white;
  position: relative;
}
.cs-hamburger-lines::before,
.cs-hamburger-lines::after {
  content: "";
  display: block;
  width: 24px;
  height: 2px;
  background: white;
  position: absolute;
}
.cs-hamburger-lines::before { top: -7px; }
.cs-hamburger-lines::after { top: 7px; }
.cs-mobile-menu {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1.5rem 2rem;
  border-top: 1px solid var(--cs-border);
}
.cs-mobile-link {
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 0.75rem;
  letter-spacing: 0.15em;
  color: var(--cs-white-80);
  text-decoration: none;
}

/* ─── HERO ────────────────────────────────────────────────────────────────────── */
.cs-hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 120px 2rem 80px;
  position: relative;
  overflow: hidden;
  max-width: 1200px;
  margin: 0 auto;
  gap: 4rem;
}
.cs-hero-bg {
  position: fixed;
  inset: 0;
  background: radial-gradient(ellipse 80% 80% at 70% 50%, #3d1f6e 0%, #1a1035 60%);
  z-index: -2;
  pointer-events: none;
}
.cs-hero-grid {
  position: fixed;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
  background-size: 60px 60px;
  z-index: -1;
  pointer-events: none;
}
.cs-hero-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
  z-index: -1;
  animation: cs-orb-float 12s ease-in-out infinite;
}
.cs-orb-1 {
  width: 500px;
  height: 500px;
  background: rgba(74,45,138,0.35);
  right: 10%;
  top: 10%;
}
.cs-orb-2 {
  width: 300px;
  height: 300px;
  background: rgba(239,68,68,0.12);
  right: 30%;
  bottom: 20%;
  animation-delay: -6s;
}
.cs-hero-content {
  flex: 1;
  max-width: 580px;
  animation: cs-fade-up 0.8s ease both;
}
.cs-hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  color: var(--red);
  text-transform: uppercase;
  margin-bottom: 1.5rem;
}
.cs-pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--red);
  flex-shrink: 0;
  animation: cs-pulse-dot 2s ease-in-out infinite;
}
.cs-hero-headline {
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: clamp(2.2rem, 5vw, 3.8rem);
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: 0.04em;
  color: var(--cs-white);
  margin-bottom: 1.5rem;
  text-transform: uppercase;
}
.cs-headline-accent {
  color: var(--red);
  text-shadow: 0 0 40px rgba(239,68,68,0.6);
}
.cs-hero-sub {
  font-size: 1.15rem;
  line-height: 1.7;
  color: var(--cs-white-60);
  margin-bottom: 2.5rem;
  font-weight: 500;
  max-width: 480px;
}
.cs-hero-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 3rem;
}
.cs-hero-stats {
  display: flex;
  gap: 2.5rem;
  flex-wrap: wrap;
}
.cs-hero-stat { display: flex; flex-direction: column; gap: 0.25rem; }
.cs-hero-stat-num {
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 1.5rem;
  color: var(--red);
  text-shadow: 0 0 20px var(--cs-red-glow-soft);
}
.cs-hero-stat-label { font-size: 0.78rem; color: var(--cs-white-60); font-weight: 500; max-width: 140px; line-height: 1.4; }
.cs-hero-visual {
  flex-shrink: 0;
  width: 360px;
  animation: cs-fade-up 0.8s 0.2s ease both;
}

/* ─── VAULT CARD ──────────────────────────────────────────────────────────────── */
.cs-vault-card {
  background: rgba(45,31,94,0.7);
  border: 1px solid var(--cs-border);
  border-radius: var(--cs-radius-lg);
  backdrop-filter: blur(20px);
  padding: 1.5rem;
  box-shadow: var(--cs-shadow-card), 0 0 60px rgba(107,75,170,0.2);
}
.cs-vault-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 0.6rem;
  letter-spacing: 0.15em;
  color: var(--cs-white-60);
  margin-bottom: 1.25rem;
  text-transform: uppercase;
}
.cs-vault-badge {
  margin-left: auto;
  background: var(--cs-red-glow-faint);
  border: 1px solid var(--cs-border-accent);
  border-radius: 4px;
  padding: 0.15rem 0.5rem;
  color: var(--red);
  font-size: 0.55rem;
}
.cs-vault-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.875rem 0;
  border-bottom: 1px solid var(--cs-border);
}
.cs-vault-row-left { display: flex; align-items: center; gap: 0.75rem; }
.cs-vault-row-right { text-align: right; }
.cs-status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  flex-shrink: 0;
}
.cs-status-ok { background: #22c55e; box-shadow: 0 0 8px rgba(34,197,94,0.6); }
.cs-status-warning { background: var(--red); animation: cs-pulse-glow 2s ease-in-out infinite; }
.cs-vault-type { font-family: var(--font-display, "Audiowide"), cursive; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--cs-white-80); }
.cs-vault-insurer { font-size: 0.78rem; color: var(--cs-white-60); margin-top: 0.2rem; font-weight: 500; }
.cs-vault-amount { font-family: var(--font-display, "Audiowide"), cursive; font-size: 0.75rem; color: var(--cs-white); letter-spacing: 0.05em; }
.cs-vault-premium { font-size: 0.75rem; color: var(--cs-white-60); margin-top: 0.2rem; font-weight: 500; }
.cs-vault-alert {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--cs-red-glow-faint);
  border: 1px solid var(--cs-border-accent);
  border-radius: var(--cs-radius-sm);
  padding: 0.625rem 0.875rem;
  color: #fca5a5;
  font-size: 0.8rem;
  font-weight: 500;
  margin: 1rem 0;
}
.cs-vault-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 0.875rem;
}
.cs-vault-total span:first-child { font-family: var(--font-display, "Audiowide"), cursive; font-size: 0.6rem; letter-spacing: 0.15em; color: var(--cs-white-60); text-transform: uppercase; }
.cs-vault-total-num { font-family: var(--font-display, "Audiowide"), cursive; font-size: 1.2rem; color: var(--cs-white); }

/* ─── LEGAL BAR ──────────────────────────────────────────────────────────────── */
.cs-legal-bar {
  background: rgba(26,16,53,0.9);
  border-top: 1px solid var(--cs-border);
  border-bottom: 1px solid var(--cs-border);
  overflow: hidden;
  padding: 0.875rem 0;
}
.cs-legal-track {
  display: inline-flex;
  gap: 3rem;
  white-space: nowrap;
  animation: cs-scroll-ticker 30s linear infinite;
}
.cs-legal-item {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 0.58rem;
  letter-spacing: 0.18em;
  color: var(--cs-white-60);
  text-transform: uppercase;
}
.cs-legal-item svg { color: var(--red); opacity: 0.7; }

/* ─── PROBLEM ─────────────────────────────────────────────────────────────────── */
.cs-problem {
  background: linear-gradient(180deg, var(--cs-purple-deep) 0%, rgba(45,31,94,0.3) 50%, var(--cs-purple-deep) 100%);
}
.cs-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin-top: 3rem;
}
.cs-stat-card {
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--cs-border);
  border-radius: var(--cs-radius-lg);
  padding: 2.5rem 2rem;
  transition: all 0.3s;
}
.cs-stat-card:hover {
  border-color: var(--cs-border-accent);
  background: rgba(239,68,68,0.05);
  transform: translateY(-4px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.3);
}
.cs-stat-card-accent { border-color: rgba(239,68,68,0.25); }
.cs-stat-num {
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: clamp(2.5rem, 5vw, 4rem);
  color: var(--red);
  text-shadow: 0 0 30px var(--cs-red-glow-soft);
  line-height: 1;
  margin-bottom: 1rem;
}
.cs-stat-desc { font-size: 0.95rem; color: var(--cs-white-60); line-height: 1.6; font-weight: 500; }

/* ─── HOW IT WORKS ────────────────────────────────────────────────────────────── */
.cs-how { background: var(--cs-purple-deep); }
.cs-steps-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 0;
  margin-top: 3rem;
  position: relative;
}
.cs-step-card {
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--cs-border);
  border-radius: var(--cs-radius-lg);
  padding: 2.5rem 2rem;
  position: relative;
  transition: all 0.3s;
}
.cs-steps-grid .cs-step-card:not(:first-child) { margin-left: -1px; }
.cs-step-card:hover {
  background: rgba(107,75,170,0.15);
  border-color: rgba(107,75,170,0.5);
  z-index: 1;
}
.cs-step-number {
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 4rem;
  color: rgba(255,255,255,0.06);
  line-height: 1;
  margin-bottom: 1.5rem;
  letter-spacing: -0.02em;
}
.cs-step-icon { color: var(--red); margin-bottom: 1rem; }
.cs-step-eyebrow {
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 0.58rem;
  letter-spacing: 0.2em;
  color: var(--cs-white-60);
  text-transform: uppercase;
  margin-bottom: 0.5rem;
}
.cs-step-title {
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 1.1rem;
  letter-spacing: 0.05em;
  color: var(--cs-white);
  margin-bottom: 1rem;
  text-transform: uppercase;
}
.cs-step-desc { font-size: 0.95rem; line-height: 1.65; color: var(--cs-white-60); font-weight: 500; }
.cs-step-arrow {
  position: absolute;
  right: -14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--red);
  z-index: 2;
  background: var(--cs-purple-deep);
  border-radius: 50%;
  padding: 2px;
}

/* ─── FEATURES ────────────────────────────────────────────────────────────────── */
.cs-features { background: linear-gradient(180deg, var(--cs-purple-deep) 0%, rgba(45,31,94,0.2) 100%); }
.cs-tier-tabs {
  display: flex;
  gap: 0;
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--cs-border);
  border-radius: var(--cs-radius-md);
  padding: 4px;
  margin-bottom: 2.5rem;
  width: fit-content;
  margin-left: auto;
  margin-right: auto;
}
.cs-tier-tab {
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  color: var(--cs-white-60);
  background: none;
  border: none;
  padding: 0.625rem 1.75rem;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s;
  text-transform: uppercase;
}
.cs-tier-tab:hover { color: var(--cs-white); }
.cs-tier-tab-active {
  background: var(--red);
  color: var(--cs-white);
  box-shadow: 0 0 20px var(--cs-red-glow-soft);
}
.cs-features-panel {
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--cs-border);
  border-radius: var(--cs-radius-lg);
  padding: 2.5rem;
}
.cs-features-panel-header { margin-bottom: 2rem; }
.cs-tier-badge {
  display: inline-block;
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 0.6rem;
  letter-spacing: 0.15em;
  padding: 0.3rem 0.75rem;
  border-radius: 4px;
  text-transform: uppercase;
  margin-bottom: 0.75rem;
}
.cs-tier-free { background: rgba(255,255,255,0.1); color: var(--cs-white-80); border: 1px solid var(--cs-border); }
.cs-tier-mid { background: var(--cs-red-glow-faint); color: #fca5a5; border: 1px solid var(--cs-border-accent); }
.cs-tier-pro { background: rgba(107,75,170,0.2); color: #c4b5fd; border: 1px solid rgba(107,75,170,0.4); }
.cs-panel-title {
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 1.4rem;
  letter-spacing: 0.05em;
  color: var(--cs-white);
  text-transform: uppercase;
}
.cs-features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}
.cs-feature-item {
  display: flex;
  gap: 1rem;
  padding: 1.25rem;
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--cs-border);
  border-radius: var(--cs-radius-md);
  transition: all 0.2s;
}
.cs-feature-item:hover { border-color: var(--cs-border-accent); background: var(--cs-red-glow-faint); }
.cs-feature-icon { color: var(--red); flex-shrink: 0; margin-top: 2px; }
.cs-feature-title { font-family: var(--font-display, "Audiowide"), cursive; font-size: 0.72rem; letter-spacing: 0.08em; color: var(--cs-white); margin-bottom: 0.4rem; text-transform: uppercase; }
.cs-feature-desc { font-size: 0.85rem; color: var(--cs-white-60); line-height: 1.55; font-weight: 500; }

/* ─── FUNERAL CAP AUDITOR ─────────────────────────────────────────────────────── */
.cs-auditor {
  background: linear-gradient(135deg, rgba(74,45,138,0.15) 0%, var(--cs-purple-deep) 50%, rgba(239,68,68,0.05) 100%);
  border-top: 1px solid var(--cs-border);
  border-bottom: 1px solid var(--cs-border);
}
.cs-auditor-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}
.cs-legal-ref {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--cs-border);
  border-radius: var(--cs-radius-sm);
  padding: 0.5rem 1rem;
  font-size: 0.78rem;
  color: var(--cs-white-60);
  font-weight: 500;
}
.cs-auditor-card {
  background: rgba(26,16,53,0.8);
  border: 1px solid var(--cs-border);
  border-radius: var(--cs-radius-lg);
  padding: 2rem;
  backdrop-filter: blur(20px);
  box-shadow: var(--cs-shadow-card);
}
.cs-auditor-card-header {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 0.62rem;
  letter-spacing: 0.15em;
  color: var(--red);
  text-transform: uppercase;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--cs-border);
}
.cs-policy-list { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1rem; }
.cs-policy-row { display: flex; gap: 0.5rem; align-items: center; }
.cs-input {
  background: rgba(255,255,255,0.06);
  border: 1px solid var(--cs-border);
  border-radius: var(--cs-radius-sm);
  color: var(--cs-white);
  padding: 0.625rem 0.875rem;
  font-family: var(--font-body, "Rajdhani"), sans-serif;
  font-size: 0.9rem;
  font-weight: 500;
  outline: none;
  transition: border-color 0.2s;
}
.cs-input:focus { border-color: rgba(239,68,68,0.5); }
.cs-input::placeholder { color: var(--cs-white-30); }
.cs-input-flex { flex: 1; }
.cs-input-prefix-wrap { position: relative; }
.cs-input-prefix { position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--cs-white-60); font-size: 0.9rem; font-weight: 600; }
.cs-input-amount { width: 140px; padding-left: 1.75rem; }
.cs-remove-btn { background: none; border: none; color: var(--cs-white-30); cursor: pointer; padding: 0.25rem; transition: color 0.2s; }
.cs-remove-btn:hover { color: var(--red); }
.cs-add-policy {
  display: block;
  width: 100%;
  background: none;
  border: 1px dashed var(--cs-border);
  border-radius: var(--cs-radius-sm);
  color: var(--cs-white-60);
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 0.62rem;
  letter-spacing: 0.12em;
  padding: 0.75rem;
  cursor: pointer;
  text-transform: uppercase;
  margin-bottom: 1rem;
  transition: all 0.2s;
}
.cs-add-policy:hover { border-color: var(--red); color: var(--red); }
.cs-audit-result {
  margin-top: 1.25rem;
  border-radius: var(--cs-radius-md);
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.cs-result-warning { background: var(--cs-red-glow-faint); border: 1px solid var(--cs-border-accent); }
.cs-result-ok { background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.3); }
.cs-result-row { display: flex; justify-content: space-between; font-size: 0.9rem; color: var(--cs-white-80); font-weight: 500; }
.cs-result-highlight { color: #fca5a5; font-weight: 700; }
.cs-result-ok-row { color: #86efac; font-weight: 700; }
.cs-result-divider { height: 1px; background: var(--cs-border); }
.cs-result-cta-text { font-size: 0.85rem; color: var(--cs-white-60); line-height: 1.55; }

/* ─── PRICING ─────────────────────────────────────────────────────────────────── */
.cs-pricing { background: var(--cs-purple-deep); }
.cs-pricing-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-top: 3rem;
  align-items: start;
}
.cs-pricing-card {
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--cs-border);
  border-radius: var(--cs-radius-lg);
  padding: 2rem;
  position: relative;
  transition: all 0.3s;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.cs-pricing-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--cs-shadow-card);
}
.cs-pricing-card-highlight {
  border-color: rgba(239,68,68,0.4);
  background: rgba(239,68,68,0.05);
  box-shadow: 0 0 40px rgba(239,68,68,0.1);
}
.cs-pricing-badge {
  position: absolute;
  top: -14px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--red);
  color: white;
  font-family: var(--font-display, "Audiowide"), cursive;
  font-size: 0.55rem;
  letter-spacing: 0.18em;
  padding: 0.3rem 1rem;
  border-radius: 20px;
  white-space: nowrap;
  box-shadow: 0 0 20px var(--cs-red-glow-soft);
  text-transform: uppercase;
}
.cs-pricing-tier { font-family: var(--font-display, "Audiowide"), cursive; font-size: 0.65rem; letter-spacing: 0.2em; color: var(--red); text-transform: uppercase; margin-bottom: 0.75rem; }
.cs-pricing-price { display: flex; align-items: baseline; gap: 0.25rem; }
.cs-price-num { font-family: var(--font-display, "Audiowide"), cursive; font-size: 2.5rem; color: var(--cs-white); }
.cs-price-period { font-size: 0.9rem; color: var(--cs-white-60); font-weight: 500; }
.cs-price-annual { font-size: 0.8rem; color: var(--cs-white-60); margin-top: 0.25rem; font-weight: 500; }
.cs-pricing-sub { font-size: 0.9rem; color: var(--cs-white-60); line-height: 1.5; margin-top: 0.5rem; font-weight: 500; }
.cs-pricing-features { display: flex; flex-direction: column; gap: 0.625rem; flex: 1; }
.cs-pricing-feature { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.88rem; color: var(--cs-white-80); font-weight: 500; }
.cs-check-icon { color: var(--red); flex-shrink: 0; margin-top: 2px; }
.cs-pricing-note { text-align: center; font-size: 0.9rem; color: var(--cs-white-60); margin-top: 2.5rem; font-weight: 500; }
.cs-inline-link { color: var(--red); text-decoration: none; }
.cs-inline-link:hover { text-decoration: underline; }

/* ─── FOOTER ──────────────────────────────────────────────────────────────────── */
.cs-footer {
  background: rgba(13,8,26,0.95);
  border-top: 1px solid var(--cs-border);
  padding: 4rem 0 2rem;
}
.cs-footer-grid { display: grid; grid-template-columns: 300px 1fr; gap: 4rem; margin-bottom: 3rem; }
.cs-footer-brand { display: flex; flex-direction: column; gap: 1rem; }
.cs-footer-tagline { font-size: 0.9rem; color: var(--cs-white-60); font-weight: 500; }
.cs-social-links { display: flex; gap: 1rem; margin-top: 0.5rem; }
.cs-social-link {
  width: 36px; height: 36px;
  display: flex; align-items: center; justify-content: center;
  background: var(--cs-white-05);
  border: 1px solid var(--cs-border);
  border-radius: var(--cs-radius-sm);
  color: var(--cs-white-60);
  transition: all 0.2s;
  text-decoration: none;
}
.cs-social-link:hover { color: var(--red); border-color: var(--cs-border-accent); box-shadow: 0 0 12px var(--cs-red-glow-soft); }
.cs-footer-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
.cs-footer-col { display: flex; flex-direction: column; gap: 0.75rem; }
.cs-footer-col-title { font-family: var(--font-display, "Audiowide"), cursive; font-size: 0.6rem; letter-spacing: 0.2em; color: var(--cs-white-60); text-transform: uppercase; margin-bottom: 0.25rem; }
.cs-footer-link { font-size: 0.88rem; color: var(--cs-white-60); text-decoration: none; font-weight: 500; transition: color 0.2s; }
.cs-footer-link:hover { color: var(--red); }
.cs-disclaimer {
  display: flex;
  gap: 0.75rem;
  background: rgba(239,68,68,0.05);
  border: 1px solid rgba(239,68,68,0.15);
  border-radius: var(--cs-radius-md);
  padding: 1.25rem 1.5rem;
  margin-bottom: 2rem;
  align-items: flex-start;
}
.cs-disclaimer svg { color: var(--red); flex-shrink: 0; margin-top: 2px; }
.cs-disclaimer p { font-size: 0.8rem; color: var(--cs-white-60); line-height: 1.6; font-weight: 500; }
.cs-disclaimer strong { color: var(--cs-white-80); }
.cs-footer-bottom { display: flex; justify-content: space-between; align-items: center; padding-top: 1.5rem; border-top: 1px solid var(--cs-border); font-size: 0.8rem; color: var(--cs-white-30); font-weight: 500; }

/* ─── RESPONSIVE ──────────────────────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .cs-hero { flex-direction: column; padding-top: 100px; text-align: center; }
  .cs-hero-content { max-width: 100%; }
  .cs-hero-actions { justify-content: center; }
  .cs-hero-stats { justify-content: center; }
  .cs-hero-visual { width: 100%; max-width: 420px; }
  .cs-steps-grid { grid-template-columns: 1fr; }
  .cs-step-arrow { display: none; }
  .cs-stats-grid { grid-template-columns: 1fr 1fr; }
  .cs-auditor-grid { grid-template-columns: 1fr; gap: 3rem; }
  .cs-footer-grid { grid-template-columns: 1fr; gap: 2.5rem; }
}

@media (max-width: 768px) {
  .cs-section { padding: 4rem 0; }
  .cs-nav-links { display: none; }
  .cs-nav-actions { display: none; }
  .cs-hamburger { display: flex; }
  .cs-stats-grid { grid-template-columns: 1fr; }
  .cs-pricing-grid { grid-template-columns: 1fr; }
  .cs-features-grid { grid-template-columns: 1fr; }
  .cs-footer-links { grid-template-columns: 1fr 1fr; }
  .cs-footer-bottom { flex-direction: column; gap: 0.5rem; text-align: center; }
  .cs-tier-tabs { flex-direction: column; width: 100%; }
  .cs-hero-stat-label { max-width: 100%; }
}

